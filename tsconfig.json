{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ESNext"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "extensions/**/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "extensions/editor-enhancements",
    "extensions/save-md",
    "extensions/skill-toggle",
    "extensions/web-tools"
  ]
}
